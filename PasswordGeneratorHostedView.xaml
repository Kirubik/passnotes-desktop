<UserControl x:Class="PassNotes.PasswordGeneratorHostedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PassNotes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BaselineDialogSurfaceBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               Text="{Binding Source={x:Static local:Loc.Instance}, Path=[Length]}"/>

                    <TextBox x:Name="LenBox"
                             Grid.Column="1"
                             VerticalContentAlignment="Center"
                             Text="16"
                             MaxLength="2"
                             PreviewTextInput="LenBox_PreviewTextInput"
                             ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>

                    <Button Grid.Column="3"
                            MinWidth="120"
                            Style="{StaticResource BaselineButton}"
                            Content="{Binding Source={x:Static local:Loc.Instance}, Path=[Generate]}"
                            Click="Generate_Click"/>

                    <Button x:Name="CopyBtn"
                            Grid.Column="5"
                            MinWidth="120"
                            Style="{StaticResource BaselineButton}"
                            Content="{Binding Source={x:Static local:Loc.Instance}, Path=[Copy]}"
                            Click="Copy_Click"/>
                </Grid>

                <Popup x:Name="CopyToastPopup"
                       PlacementTarget="{Binding ElementName=CopyBtn}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Focusable="False">
                    <Border Style="{StaticResource BaselineToastBorder}">
                        <TextBlock Style="{StaticResource BaselineToastText}"
                                   Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopiedPassword]}"/>
                    </Border>
                </Popup>

                <Popup x:Name="CopyFailedToastPopup"
                       PlacementTarget="{Binding ElementName=CopyBtn}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="True"
                       Focusable="False">
                    <Border Style="{StaticResource BaselineToastBorder}">
                        <TextBlock Style="{StaticResource BaselineToastText}"
                                   Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyFailed]}"/>
                    </Border>
                </Popup>

                <TextBox x:Name="OutBox"
                         Grid.Row="2"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource BaselineDialogActionsPanel}">
            <Button Style="{StaticResource BaselineDialogButton}"
                    MinWidth="120"
                    Content="{Binding Source={x:Static local:Loc.Instance}, Path=[Close]}"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
