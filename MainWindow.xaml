            <GridSplitter x:Name="FolderSplitter" Grid.Column="2"
                          Width="2"
                          Background="{DynamicResource Brush.Divider}"
                          Focusable="False"
                          IsTabStop="False"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ShowsPreview="False"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          DragCompleted="FolderSplitter_DragCompleted" />

            <Border Grid.Column="3"
                    Background="{DynamicResource Brush.SurfaceSubtleBackground}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <Grid x:Name="EntriesPaneHost"
                      ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

				<!-- Breadcrumbs only (keep canvas clean) -->
				<Border Grid.Row="0"
                        Panel.ZIndex="0"
                        Margin="0,0,0,6"
                        Style="{StaticResource BaselinePassiveInsetStripBorder}">
                    <Grid SnapsToDevicePixels="True" ClipToBounds="True">
                                        <TextBlock Text="&#8212;" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Visible"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsBreadcrumbVisible}" Value="True">
										<Setter Property="Visibility" Value="Collapsed"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<ItemsControl ItemsSource="{Binding ActiveContextBreadcrumbs}">
						<ItemsControl.Style>
							<Style TargetType="ItemsControl">
								<Setter Property="Visibility" Value="Collapsed"/>
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsBreadcrumbVisible}" Value="True">
										<Setter Property="Visibility" Value="Visible"/>
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</ItemsControl.Style>

						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<StackPanel Orientation="Horizontal"/>
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>

						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
									<Button Style="{StaticResource BaselineFlatActionButton}" Margin="0"
												Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
												CommandParameter="{Binding}">
										<TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextSecondary}">
											<TextBlock.Style>
												<Style TargetType="TextBlock">
													<Setter Property="TextDecorations" Value="{x:Null}"/>
													<Style.Triggers>
														<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
															<Setter Property="TextDecorations" Value="Underline"/>
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
									</Button>

									<TextBlock Text=" / " Foreground="{DynamicResource Brush.TextMuted}" Margin="4,0">
										<TextBlock.Style>
											<Style TargetType="TextBlock">
												<Setter Property="Visibility" Value="Visible"/>
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsLast}" Value="True">
														<Setter Property="Visibility" Value="Collapsed"/>
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</TextBlock.Style>
									</TextBlock>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				    </Grid>
				</Border>


            <DataGrid x:Name="Grid"
                      Grid.Row="1"
                      Panel.ZIndex="1"
                      behaviors:ExplorerSelectionBehavior.Enable="False"
                      KeyboardNavigation.DirectionalNavigation="None"
                      BorderThickness="1"
                      BorderBrush="{DynamicResource Brush.GridLine}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="True"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      Background="{DynamicResource Brush.SurfaceBackground}"
                      RowBackground="{DynamicResource Brush.SurfaceBackground}"
                      AlternatingRowBackground="{DynamicResource Brush.SurfaceBackground}"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowStyle="{DynamicResource EntriesGridRowStyle}"
                      CellStyle="{StaticResource BaselineDataGridCell}"
                      AlternationCount="1000000"
                      RowHeight="{Binding ElementName=RowHeightSlider, Path=Value}"
                      ColumnHeaderHeight="24"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      RowHeaderStyle="{x:Null}"
                      GridLinesVisibility="None"
                      HorizontalGridLinesBrush="{DynamicResource Brush.GridLine}"
                      VerticalGridLinesBrush="{DynamicResource Brush.GridLine}"
                      ColumnWidth="*"
                      PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown"
                      PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
                      PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                      PreviewMouseMove="Grid_PreviewMouseMove"
                      MouseDoubleClick="Grid_MouseDoubleClick"
	                      ColumnHeaderStyle="{DynamicResource EntriesGridColumnHeaderStyle}"
                      >

                <DataGrid.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteSelectedEntriesCommand}"/>
                    <KeyBinding Modifiers="Control" Key="A" Command="{Binding SelectAllEntriesCommand}"/>
                </DataGrid.InputBindings>

                
<DataGrid.Resources>
                    <Style x:Key="EntriesGridRowStyle" TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource BaselineDataGridRow}">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="EntriesGridRow_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="EntriesGridRow_PreviewMouseRightButtonDown"/>
                    </Style>

                    <Style x:Key="FavoriteStarGlyphStyle" TargetType="{x:Type ContentControl}" BasedOn="{StaticResource BaselineVectorIconPresenter}">
                        <Setter Property="Width" Value="15"/>
                        <Setter Property="Height" Value="15"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="0,0,0,0"/>
                    </Style>

                    <Style x:Key="FavoriteStarButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineFlatActionButton}">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="Transparent"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>

                    <ContextMenu x:Key="EntriesGridHeaderContextMenu"
                                 Style="{StaticResource BaselineContextMenu}"
                                 Opened="UpdatedColumnHeaderMenu_Opened">
                        <MenuItem Tag="ToggleUpdatedColumn"
                                  IsCheckable="True"
                                  Header="{Binding Source={x:Static local:Loc.Instance}, Path=[ShowUpdatedColumn]}"
                                  Click="ToggleUpdatedColumn_Click"/>
                    </ContextMenu>

                    <Style x:Key="EntriesGridColumnHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource BaselineDataGridColumnHeader}">
                        <Setter Property="ContextMenu" Value="{StaticResource EntriesGridHeaderContextMenu}"/>
                        <Setter Property="Padding" Value="8,4,8,4"/>
                        <!-- Keep default header template (so resize grippers work), only change header content -->
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ContentPresenter Grid.Column="0"
                                                          Content="{Binding}"
                                                          HorizontalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=HorizontalContentAlignment}"
                                                          VerticalAlignment="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=VerticalContentAlignment}"/>

                                        <!-- Excel-like sort hint: Р В Р’В Р В РІР‚В Р В Р вЂ Р В РІР‚С™Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р вЂ™Р’В¦ always visible for sortable columns; Р В Р’В Р В РІР‚В Р В Р вЂ Р В РІР‚С™Р Р†Р вЂљРЎС™Р В Р’В Р Р†Р вЂљР’В /Р В Р’В Р В РІР‚В Р В Р вЂ Р В РІР‚С™Р Р†Р вЂљРЎС™Р В Р Р‹Р вЂ™Р’В when sorted -->
                                        <ContentControl x:Name="SortGlyph"
                                                        Grid.Column="1"
                                                        Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                        Width="10"
                                                        Height="10"
                                                        Foreground="{DynamicResource Brush.TextMuted}"
                                                        Content="{StaticResource IconData.Sort.Neutral}"/>
                                    </Grid>

                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=SortDirection}" Value="Ascending">
                                            <Setter TargetName="SortGlyph" Property="Content" Value="{StaticResource IconData.Sort.Ascending}"/>
                                            <Setter TargetName="SortGlyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=SortDirection}" Value="Descending">
                                            <Setter TargetName="SortGlyph" Property="Content" Value="{StaticResource IconData.Sort.Descending}"/>
                                            <Setter TargetName="SortGlyph" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridColumnHeader}, Path=Column.CanUserSort}" Value="False">
                                            <Setter TargetName="SortGlyph" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="SortDirection" Value="Ascending">
                                <Setter Property="Background" Value="{DynamicResource Brush.TabSelectedBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GridLine}"/>
                            </Trigger>
                            <Trigger Property="SortDirection" Value="Descending">
                                <Setter Property="Background" Value="{DynamicResource Brush.TabSelectedBackground}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.GridLine}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>



<DataGrid.Columns>

                    <!-- Р В Р’В Р В РІР‚В Р В Р вЂ Р В РІР‚С™Р РЋРІР‚С”Р В Р вЂ Р В РІР‚С™Р Р†Р вЂљРЎС™ -->
                    <DataGridTextColumn Header="&#8470;"
                                        IsReadOnly="True"
                                        CanUserSort="False"
                                        Width="50" MinWidth="40"
                                        Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                          Path=(ItemsControl.AlternationIndex),
                                                          Converter={StaticResource RowNumberConverter}}"/>

                    <!-- Р В Р’В Р В РІР‚В Р В РІР‚в„ўР вЂ™Р’ВР В Р вЂ Р В РІР‚С™Р вЂ™Р’В¦ Favorite toggle (UI only) -->
                    <DataGridTemplateColumn Header="{StaticResource IconData.Favorite.Filled}" Width="38" MinWidth="34"
                                            CanUserSort="False"
                                            CanUserReorder="False"
                                            CanUserResize="False">
                        <!-- Use a header template to keep default header visuals and make the star fully monochrome -->
<DataGridTemplateColumn.HeaderStyle>
                            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource EntriesGridColumnHeaderStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" Style="{StaticResource FavoriteStarGlyphStyle}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTemplateColumn.HeaderStyle>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent">
                                    <ContentControl x:Name="FavoriteStarGlyph"
                                                    Content="{StaticResource IconData.Favorite.Empty}"
                                                    Style="{StaticResource FavoriteStarGlyphStyle}"
                                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Foreground}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                    <Button Style="{StaticResource FavoriteStarButtonStyle}"
                                            PreviewMouseLeftButtonDown="FavoriteStar_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="FavoriteStar_PreviewMouseLeftButtonUp"
                                            Focusable="False"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter TargetName="FavoriteStarGlyph" Property="Content" Value="{StaticResource IconData.Favorite.Filled}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="TitleColumn"
                                        Binding="{Binding Title}" SortMemberPath="Title"
                                        Width="2*" MinWidth="140"
                                        Header="{Binding Source={x:Static local:Loc.Instance}, Path=[TitleCol]}"/>

                    <!-- Folder path is shown only in aggregated contexts (Favorites / global search) -->
                    <DataGridTextColumn x:Name="FolderPathColumn"
                                        Binding="{Binding UiFolderPath}"
                                        Visibility="Collapsed"
                                        IsReadOnly="True"
                                        CanUserSort="False"
                                        Width="2*" MinWidth="160"
                                        Header="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderCol]}"/>

                    <DataGridTextColumn x:Name="UsernameColumn"
                                        Binding="{Binding Username}" SortMemberPath="Username"
                                        Width="2*" MinWidth="140"
                                        Header="{Binding Source={x:Static local:Loc.Instance}, Path=[UsernameCol]}"/>

                    <DataGridTemplateColumn x:Name="UrlColumn"
                                            SortMemberPath="Url"
                                            Width="4*" MinWidth="220"
                                            Header="{Binding Source={x:Static local:Loc.Instance}, Path=[UrlCol]}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               VerticalAlignment="Center"
                                               Text="{Binding Url}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Url}"/>

                                    <Button x:Name="CopyUrlButton"
                                            Grid.Column="1"
                                            Style="{StaticResource EntryUrlInlineActionButton}"
                                            Click="CopyUrl_Click"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding Url, Converter={StaticResource EntryUrlActionAvailabilityConverter}, ConverterParameter=copy}"
                                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyUrl]}">
                                        <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                        Content="IconData.Copy"/>
                                    </Button>

                                    <Button x:Name="OpenUrlButton"
                                            Grid.Column="2"
                                            Style="{StaticResource EntryUrlInlineActionButton}"
                                            Click="OpenUrlInBrowser_Click"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding Url, Converter={StaticResource EntryUrlActionAvailabilityConverter}, ConverterParameter=open}"
                                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[OpenUrlInBrowser]}">
                                        <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                        Content="IconData.Open"/>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                        <Setter TargetName="CopyUrlButton" Property="IsEnabled" Value="False"/>
                                        <Setter TargetName="OpenUrlButton" Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn x:Name="UpdatedUtcColumn"
                                        SortMemberPath="UpdatedUtc"
                                        Binding="{Binding UpdatedUtc, Converter={StaticResource UtcToDisplayDateTimeConverter}, StringFormat={}{0:G}}"
                                        Visibility="Collapsed"
                                        Width="2*" MinWidth="170"
                                        Header=""/>

                </DataGrid.Columns>

                <DataGrid.ContextMenu>
                    <ContextMenu Style="{StaticResource BaselineContextMenu}"
                                 Opened="GridContextMenu_Opened">
                        <MenuItem Tag="Add" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[Add]}" Click="Add_Click"/>
                        <MenuItem Tag="Edit" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[Edit]}" Click="Edit_Click"/>
                        <MenuItem Tag="Delete" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[Delete]}" Click="Delete_Click"/>
                        <MenuItem Tag="TrashRestore" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[TrashRestore]}" Click="TrashRestore_Click"/>
                        <MenuItem Tag="TrashDeleteForever" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[TrashDeleteForever]}" Click="TrashDeleteForever_Click"/>
                        <MenuItem Tag="TrashEmpty" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[TrashEmpty]}" Click="TrashEmpty_Click"/>
                        <Separator/>
                        <MenuItem Tag="FavAdd" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[AddToFavorites]}" Click="FavAdd_Click"/>
                        <MenuItem Tag="FavRemove" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[RemoveFromFavorites]}" Click="FavRemove_Click"/>
                        <Separator Tag="GoToEntryFolderSepBefore"/>
                        <MenuItem Tag="GoToEntryFolder" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[GoToEntryFolder]}" Click="GoToEntryFolder_Click"/>
                        <Separator Tag="GoToEntryFolderSepAfter"/>
                        <MenuItem Tag="CopyUsername" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyUsername]}" Click="CopyUsername_Click"/>
                        <MenuItem Tag="CopyPassword" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyPassword]}" Click="CopyPassword_Click"/>
                        <MenuItem Tag="CopyUrl" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyUrl]}" Click="CopyUrl_Click"/>
                        <MenuItem Tag="OpenUrlInBrowser" Header="{Binding Source={x:Static local:Loc.Instance}, Path=[OpenUrlInBrowser]}" Click="OpenUrlInBrowser_Click"/>
                        <Separator/>
                        <MenuItem Tag="ToggleUpdatedColumn"
                                  IsCheckable="True"
                                  Header="{Binding Source={x:Static local:Loc.Instance}, Path=[ShowUpdatedColumn]}"
                                  Click="ToggleUpdatedColumn_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
            </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>

    <Grid x:Name="HostedDialogLayer"
          Panel.ZIndex="100"
          Visibility="{Binding HostedDialogHost.IsOpen, Converter={StaticResource BoolToVis}}"
          SizeChanged="HostedDialogLayer_SizeChanged"
          Focusable="False"
          FocusVisualStyle="{x:Null}"
          FocusManager.IsFocusScope="True"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border x:Name="HostedDialogFocusAnchor"
                Width="1"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                Opacity="0"
                Focusable="True"
                FocusVisualStyle="{x:Null}"
                IsHitTestVisible="False"/>
        <Border Style="{StaticResource BaselineDialogHostBackdrop}"
                MouseLeftButtonDown="HostedDialogBackdrop_MouseLeftButtonDown"/>
        <Border Style="{StaticResource BaselineDialogHostShell}"
                Width="{Binding HostedDialogHost.Width}"
                MinWidth="{Binding HostedDialogHost.MinWidth}"
                MaxWidth="{Binding HostedDialogHost.MaxWidth}"
                Height="{Binding HostedDialogHost.Height}"
                MinHeight="{Binding HostedDialogHost.MinHeight}"
                MaxHeight="{Binding ElementName=HostedDialogLayer, Path=ActualHeight}"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BaselineDialogTitleText}"
                           Text="{Binding HostedDialogHost.Title}"/>
                <ContentPresenter Grid.Row="1"
                                  Margin="0,12,0,0"
                                  MinHeight="0"
                                  VerticalAlignment="Stretch"
                                  Content="{Binding HostedDialogHost.Content}"/>
                <StackPanel Grid.Row="2"
                            Style="{StaticResource BaselineDialogActionsPanel}"
                            Visibility="{Binding HostedDialogHost.HasVisibleButtons, Converter={StaticResource BoolToVis}}">
                    <Button x:Name="HostedDialogTertiaryButton"
                            Style="{StaticResource BaselineDialogButton}"
                            Content="{Binding HostedDialogHost.TertiaryButtonText}"
                            Visibility="{Binding HostedDialogHost.IsTertiaryButtonVisible, Converter={StaticResource BoolToVis}}"
                            Click="HostedDialogTertiaryButton_Click"/>
                    <Button x:Name="HostedDialogSecondaryButton"
                            Margin="8,0,0,0"
                            Style="{StaticResource BaselineDialogButton}"
                            Content="{Binding HostedDialogHost.SecondaryButtonText}"
                            Visibility="{Binding HostedDialogHost.IsSecondaryButtonVisible, Converter={StaticResource BoolToVis}}"
                            Click="HostedDialogSecondaryButton_Click"/>
                    <Button x:Name="HostedDialogPrimaryButton"
                            Margin="8,0,0,0"
                            Style="{StaticResource BaselineDialogButton}"
                            Content="{Binding HostedDialogHost.PrimaryButtonText}"
                            Visibility="{Binding HostedDialogHost.IsPrimaryButtonVisible, Converter={StaticResource BoolToVis}}"
                            Click="HostedDialogPrimaryButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Grid>
</Window>




