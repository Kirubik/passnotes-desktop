            <!-- Р В Р’В Р вЂ™Р’В Р В Р вЂ Р В РІР‚С™Р Р†РІР‚С›РЎС›Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р В Р вЂ№Р В Р’В Р Р†Р вЂљРЎв„ўР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р РЋРІвЂћСћР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В»Р В Р’В Р В Р вЂ№Р В Р’В Р В РІР‚В°Р В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В¦Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р В Р вЂ№Р В Р’В Р В Р РЏ Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎС›Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В±Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В»Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р В Р вЂ№Р В Р’В Р РЋРІР‚СљР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р РЋРІвЂћСћР В Р’В Р В Р вЂ№Р В Р’В Р В РІР‚В° Р В Р’В Р В Р вЂ№Р В Р’В Р РЋРІР‚СљР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В»Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°: Р В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В Р В Р’В Р В Р вЂ№Р В Р’В Р РЋРІР‚СљР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СљР В Р’В Р вЂ™Р’В Р В РЎС›Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В° Р В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В РЎС›Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В Р Р‹Р вЂ™Р’ВР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°, Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СњР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎС› Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В»Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р В Р вЂ№Р В Р Р‹Р Р†Р вЂљРЎС™ Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎС›Р В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р РЋРІвЂћСћР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р В Р вЂ№Р В Р’В Р Р†Р вЂљРЎв„ўР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р Р†РІР‚С›РІР‚вЂњР В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р РЋРІвЂћСћ/Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В·Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р В Р вЂ№Р В Р’В Р Р†Р вЂљРЎв„ўР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р Р†РІР‚С›РІР‚вЂњР В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р В Р вЂ№Р В Р вЂ Р В РІР‚С™Р РЋРІвЂћСћ Р В Р’В Р вЂ™Р’В Р В Р Р‹Р вЂ™Р’ВР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В¦Р В Р’В Р В Р вЂ№Р В Р’В Р Р†Р вЂљРІвЂћвЂ“ Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СњР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СњР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎС›Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљ -->
            <Button x:Name="FolderHandle"
                    Grid.Column="0"
                    Style="{StaticResource BaselineTreeChevronButton}"
                    Click="ToggleFolders_Click"/>


            <Border x:Name="FolderPanel"
                    Grid.Column="1"
                    Background="{DynamicResource Brush.SurfaceSubtleBackground}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8">
                <DockPanel LastChildFill="True">

                    <!-- Folder search + actions (left aligned; does not "ride" when panel width changes) -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource BaselinePassiveInsetStripBorder}"
                            Margin="0,0,0,6">
                    <Grid x:Name="FolderTopBar"
                          SnapsToDevicePixels="True"
                          SizeChanged="FolderTopBar_SizeChanged">
                        <Grid.ColumnDefinitions>
                            <!-- Search box (width is adjusted in code-behind on resize to prevent border clipping) -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Action buttons -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Filler so the group stays on the left -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search box wrapper draws the border (so it never looks "torn") -->
                        <Border Grid.Column="0"
                                Style="{StaticResource BaselineSearchHostBorder}"
                                Margin="0,0,8,0">
                            <Grid>
                                <TextBox x:Name="FolderSearchBox"
                                         Style="{StaticResource BaselineHostedSearchTextBox}"
                                         Width="200"
                                         TextChanged="FolderSearchBox_TextChanged"
                                         PreviewKeyDown="FolderSearchBox_PreviewKeyDown"
                                         ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderSearchPlaceholder]}"
                                         ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>

                                <!-- Watermark -->
                                <TextBlock Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           IsHitTestVisible="False"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderSearchPlaceholder]}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FolderSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Clear (watermark "x") - same behavior as entry search -->
                                <Button Click="ClearFolderSearchBox_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaselineSearchClearButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=FolderSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                    Content="{StaticResource IconData.Close.Small}"
                                                    Foreground="{DynamicResource Brush.IconMuted}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <StackPanel x:Name="FolderActionsPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                            <Button x:Name="AddFolderBtn"
                                    Margin="0,0,4,0"
                                    Click="AddFolder_Click"
                                    Style="{StaticResource BaselineToolbarIconButton}"
                                    ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderNew]}">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Folder.Add}"/>
                            </Button>

                            <Button x:Name="RenameFolderBtn"
                                    Margin="0,0,4,0"
                                    Click="RenameFolder_Click"
                                    Style="{StaticResource BaselineToolbarIconButton}"
                                    ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[EditTip]}">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Folder.Edit}"/>
                            </Button>

                            <Button x:Name="DeleteFolderBtn"
                                    Click="DeleteFolder_Click"
                                    Style="{StaticResource BaselineToolbarIconButton}"
                                    ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderDelete]}">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Folder.Delete}"/>
                            </Button>

                            <!-- Variant A: Folder multi-select mode (checkboxes + action strip) -->
                            <ToggleButton x:Name="FolderMultiSelectToggle"
                                          Margin="8,0,0,0"
                                          Style="{StaticResource BaselineToolbarToggleButton}"
                                          ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[FolderMultiSelectMode]}"
                                          IsChecked="{Binding IsFolderMultiSelectMode, Mode=TwoWay}">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.MultiSelect}"/>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                    </Border>

                    <!-- Folder multi-select action strip (visible only in multi-select mode)
                         IMPORTANT: DockPanel defaults to Dock="Left" for children without an explicit DockPanel.Dock.
                         When this strip becomes visible it can steal all available width, making the TreeView appear "empty".
                         We dock it to Top so it only consumes height. -->
                    <Border DockPanel.Dock="Top"
                            Style="{StaticResource BaselinePassiveInsetStripBorder}"
                            Margin="0,6,0,6"
                            Visibility="{Binding IsFolderMultiSelectUiVisible, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource BaselineToolbarIconButton}"
                                        Margin="0,0,6,0"
                                        Command="{Binding DeleteCheckedFoldersCommand}"
                                        ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[Delete]}">
                                    <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Folder.Delete}"/>
                                </Button>
                                <Button Style="{StaticResource BaselineToolbarIconButton}"
                                        Command="{Binding ClearCheckedFoldersCommand}"
                                        ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[ClearSelection]}">
                                    <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.ClearSelection}"/>
                                </Button>
                            </StackPanel>

                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       Text="{Binding CheckedFoldersInfo}"/>
                        </DockPanel>
                    </Border>

                    <Border Background="{DynamicResource Brush.SurfaceBackground}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                    <TreeView x:Name="FolderTree"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown"
                              PreviewKeyDown="FolderTree_PreviewKeyDown"
                              PreviewMouseMove="FolderTree_PreviewMouseMove"
                              MouseLeave="FolderTree_MouseLeave"
                              AllowDrop="True"
                              PreviewDragOver="FolderTree_PreviewDragOver"
                              PreviewDragLeave="FolderTree_PreviewDragLeave"
                              PreviewDrop="FolderTree_PreviewDrop"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ItemContainerStyle="{DynamicResource FolderTreeItemStyle}">

                        <TreeView.InputBindings>
                            <KeyBinding Key="Delete" Command="{Binding DeleteSelectedOrCheckedFoldersCommand}"/>
                        </TreeView.InputBindings>
                        <TreeView.Resources>
                            <!-- Variant A (Explorer-like): fixed space for expander on every row.
                                 For items without children, the expander is Hidden (space kept),
                                 which prevents "floating" look for leaf nodes. -->
                            <Style x:Key="FolderTreeItemStyle" TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource BaselineTreeViewItem}">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVis}}"/>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <ToggleButton x:Name="Expander"
                                                              Panel.ZIndex="2"
                                                              Grid.Row="0"
                                                              Grid.Column="0"
                                                              Margin="1,0,1,0"
                                                              Style="{StaticResource BaselineTreeChevronToggleButton}"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>

                                                <Border x:Name="Bd"
                                                        Grid.Row="0"
                                                        Grid.Column="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Grid Margin="{TemplateBinding Padding}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="4"/>
                                                            <ColumnDefinition Width="5"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border x:Name="ActiveContextMark"
                                                                Grid.Column="0"
                                                                Background="Transparent"
                                                                CornerRadius="2"/>
                                                        <ContentPresenter x:Name="PART_Header"
                                                                          Grid.Column="2"
                                                                          ContentSource="Header"
                                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="Center"
                                                                          RecognizesAccessKey="True"/>
                                                    </Grid>
                                                </Border>

                                                <ItemsPresenter x:Name="ItemsHost"
                                                                Grid.Row="1"
                                                                Panel.ZIndex="1"
                                                                Grid.Column="1"/>
                                            </Grid>

                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActiveContext}" Value="True">
                                                    <Setter TargetName="ActiveContextMark" Property="Background" Value="{DynamicResource Brush.ActiveContextMarker}"/>
                                                </DataTrigger>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding HasChildFoldersHint}" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsSelected}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.IsFolderMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <!-- Multi-select checkbox for folders (TreeView has no native multi-select).
                                         Checking/unchecking does NOT change the active context on the right. -->
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Focusable="False"
                                              PreviewMouseDown="FolderCheckBox_PreviewMouseDown"
                                              >
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource BaselineCheckBox}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Kind}" Value="{x:Static local:FolderNodeKind.Folder}"/>
                                                            <Condition Binding="{Binding DataContext.IsFolderMultiSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎС›Р В Р’В Р вЂ™Р’В Р В Р’В Р Р†Р вЂљР’В¦Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В° Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СњР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРІР‚СњР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљРЎСљР В Р’В Р вЂ™Р’В Р В Р Р‹Р Р†Р вЂљР’В/Р В Р’В Р В Р вЂ№Р В Р’В Р Р†Р вЂљРЎв„ўР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В°Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В·Р В Р’В Р вЂ™Р’В Р В РЎС›Р Р†Р вЂљР’ВР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’ВµР В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В»Р В Р’В Р вЂ™Р’В Р В РІР‚в„ўР вЂ™Р’В° -->
                                    <ContentControl Margin="0,0,6,0" VerticalAlignment="Center">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl" BasedOn="{StaticResource BaselineVectorIconPresenter}">
