<Window x:Class="PassNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PassNotes"
        xmlns:behaviors="clr-namespace:PassNotes.Behaviors"
        Title="{Binding Source={x:Static local:Loc.Instance}, Path=[AppTitle]}"
        Width="860"
        Height="700"
        FontFamily="Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        behaviors:HostedDialogVisualScope.IsHostedDialogOpen="{Binding HostedDialogHost.IsOpen}"
        Background="{DynamicResource Brush.WindowBackground}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:RowNumberConverter x:Key="RowNumberConverter"/>
        <local:WidthToTextConverter x:Key="WidthToTextConverter"/>
        <local:UtcToDisplayDateTimeConverter x:Key="UtcToDisplayDateTimeConverter"/>
        <local:EntryUrlActionAvailabilityConverter x:Key="EntryUrlActionAvailabilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="EntryAnySelectionIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineToolbarIconButton}">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedEntriesCount}" Value="0">
                    <Setter Property="IsEnabled" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntrySingleSelectionIconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineToolbarIconButton}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedEntriesCount}" Value="1">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EntryUrlInlineActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineToolbarIconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel x:Name="ShellContentRoot" Margin="8">

        <!-- Top toolbar (Entries: menu + search + actions + generator/row height) -->
        <Border DockPanel.Dock="Top"
                Margin="14,0,0,10"
                Background="{DynamicResource Brush.SurfaceSubtleBackground}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8,8,10,8"
                SnapsToDevicePixels="True">
        <Grid SnapsToDevicePixels="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <ToggleButton x:Name="EntriesMenuBtn"
                          Grid.Column="0"
                          Margin="0,0,8,0"
                          Style="{StaticResource BaselineToolbarMenuButton}"
                          ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[Menu]}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Menu}"/>
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding Source={x:Static local:Loc.Instance}, Path=[Menu]}"/>
                </StackPanel>
            </ToggleButton>

            <Popup x:Name="EntriesMenuPopup"
                   PlacementTarget="{Binding ElementName=EntriesMenuBtn}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   IsOpen="{Binding IsChecked, ElementName=EntriesMenuBtn}"
                   Closed="EntriesMenuPopup_Closed">
                <Border Style="{StaticResource BaselinePopupSurfaceBorder}">
                    <StackPanel>
                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="OpenSettings_Click" IsEnabled="{Binding IsUnlocked}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Settings}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[SettingsMenu]}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="OpenHelp_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Help}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[HelpMenu]}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="OpenSupportAuthor_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Support}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[SupportAuthorMenu]}"/>
                            </StackPanel>
                        </Button>


	                        <Separator Style="{StaticResource PassNotesSeparator}" Margin="2,4"/>

	                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="ImportVault_Click" IsEnabled="{Binding IsUnlocked}">
	                            <StackPanel Orientation="Horizontal">
	                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Import}" Margin="0,0,8,0"/>
	                                <TextBlock VerticalAlignment="Center"
	                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[ImportVault]}"/>
	                            </StackPanel>
	                        </Button>

	                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="ExportVault_Click" IsEnabled="{Binding IsUnlocked}">
	                            <StackPanel Orientation="Horizontal">
	                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Export}" Margin="0,0,8,0"/>
	                                <TextBlock VerticalAlignment="Center"
	                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[ExportVault]}"/>
	                            </StackPanel>
	                        </Button>

	                        <Separator Style="{StaticResource PassNotesSeparator}" Margin="2,4"/>

	                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="CreateBackupNow_Click" IsEnabled="{Binding IsUnlocked}">
	                            <StackPanel Orientation="Horizontal">
	                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Backup.Create}" Margin="0,0,8,0"/>
	                                <TextBlock VerticalAlignment="Center"
	                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[BackupCreateNow]}"/>
	                            </StackPanel>
	                        </Button>

	                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="RestoreFromBackup_Click" IsEnabled="{Binding IsUnlocked}">
	                            <StackPanel Orientation="Horizontal">
	                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Backup.Restore}" Margin="0,0,8,0"/>
	                                <TextBlock VerticalAlignment="Center"
	                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[BackupRestore]}"/>
	                            </StackPanel>
	                        </Button>

	                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="OpenBackupsFolder_Click" IsEnabled="{Binding IsUnlocked}">
	                            <StackPanel Orientation="Horizontal">
	                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.OpenFolder}" Margin="0,0,8,0"/>
	                                <TextBlock VerticalAlignment="Center"
	                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[BackupOpenFolder]}"/>
	                            </StackPanel>
	                        </Button>

	                        <Separator Style="{StaticResource PassNotesSeparator}" Margin="2,4"/>


                        <Button Style="{StaticResource BaselinePopupMenuItemButton}"
                                Click="LockFromMenu_Click"
                                Visibility="{Binding CanStartLock, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Lock}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[Lock]}"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource BaselinePopupMenuItemButton}"
                                Click="UnlockFromMenu_Click"
                                Visibility="{Binding CanStartUnlock, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Unlock}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[Unlock]}"/>
                            </StackPanel>
                        </Button>


                        <Separator Style="{StaticResource PassNotesSeparator}" Margin="2,4"/>

                        <Button Style="{StaticResource BaselinePopupMenuItemButton}" Click="ExitApp_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Exit}" Margin="0,0,8,0"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{Binding Source={x:Static local:Loc.Instance}, Path=[Exit]}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Popup>

            <!-- Search + context chip -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="{Binding IsUnlocked}">
                <Border Style="{StaticResource BaselineSearchHostBorder}">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource BaselineHostedSearchTextBox}"
                                 Width="220"
                                 TextChanged="SearchBox_TextChanged"
                                 ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[EntrySearchPlaceholder]}"
                                 ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>

                        <!-- Watermark (like folder search) -->
                        <TextBlock Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   IsHitTestVisible="False"
                                   Text="{Binding Source={x:Static local:Loc.Instance}, Path=[EntrySearchPlaceholder]}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Clear (watermark "x") -->
                        <Button Click="ClearSearchBox_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BaselineSearchClearButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                            Content="{StaticResource IconData.Close.Small}"
                                            Foreground="{DynamicResource Brush.IconMuted}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Context chip (visible only when ActiveFolderContext is set). X clears context (shows 0 entries; no "all entries" mode). -->
                <Border Style="{StaticResource BaselineInfoChipBorder}"
                        Margin="8,0,0,0"
                        Visibility="{Binding IsContextSet, Converter={StaticResource BoolToVis}}">
                    <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}"
                                        Content="{StaticResource IconData.Folder}"
                                        Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding ActiveContextTitle}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Command="{Binding ClearContextCommand}"
                                Style="{StaticResource BaselineFlatActionButton}"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                            Content="{StaticResource IconData.Close.Small}"
                                            Foreground="{DynamicResource Brush.IconMuted}"/>
                        </Button>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Entry actions (icons to the right of search) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" IsEnabled="{Binding IsUnlocked}">
                    <Button x:Name="EntryAddBtn"
                            Margin="0,0,4,0"
                            Click="Add_Click"
                            Style="{StaticResource BaselineToolbarIconButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[Add]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Entry.Add}"/>
                    </Button>

                    <Button x:Name="EntryEditBtn"
                            Margin="0,0,4,0"
                            Click="Edit_Click"
                            Style="{StaticResource EntrySingleSelectionIconButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[EditTip]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Entry.Edit}"/>
                    </Button>

                    <Button x:Name="EntryDeleteBtn"
                            Margin="0,0,4,0"
                            Click="Delete_Click"
                            Style="{StaticResource EntryAnySelectionIconButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[Delete]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Entry.Delete}"/>
                    </Button>
                    <Button x:Name="CopyLoginBtn"
                            Margin="0,0,4,0"
                            Click="CopyUsername_Click"
                            Style="{StaticResource EntrySingleSelectionIconButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyUsername]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Copy.Login}"/>
                    </Button>

                    <Button x:Name="CopyPassBtn"
                            Click="CopyPassword_Click"
                            Style="{StaticResource EntrySingleSelectionIconButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyPassword]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}" Content="{StaticResource IconData.Copy.Password}"/>
                    </Button>

                    <!-- Lightweight toasts for Copy actions (avoid MessageBox focus/activation flicker) -->
                    <Popup x:Name="CopyLoginToastPopup"
                           PlacementTarget="{Binding ElementName=CopyLoginBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopiedLogin]}"/>
                        </Border>
                    </Popup>

                    <Popup x:Name="CopyLoginFailedToastPopup"
                           PlacementTarget="{Binding ElementName=CopyLoginBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyFailed]}"/>
                        </Border>
                    </Popup>

                    <Popup x:Name="CopyPasswordToastPopup"
                           PlacementTarget="{Binding ElementName=CopyPassBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopiedPassword]}"/>
                        </Border>
                    </Popup>

                    <Popup x:Name="CopyPasswordFailedToastPopup"
                           PlacementTarget="{Binding ElementName=CopyPassBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[CopyFailed]}"/>
                        </Border>
                    </Popup>

                    <!-- Info toast for actions that require a single selected entry (avoid MessageBox) -->
                    <Popup x:Name="NeedSelectCopyLoginToastPopup"
                           PlacementTarget="{Binding ElementName=CopyLoginBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[NeedSelect]}"/>
                        </Border>
                    </Popup>

                    <Popup x:Name="NeedSelectCopyPasswordToastPopup"
                           PlacementTarget="{Binding ElementName=CopyPassBtn}"
                           Placement="Bottom"
                           AllowsTransparency="True"
                           StaysOpen="True"
                           Focusable="False">
                        <Border Style="{StaticResource BaselineToastBorder}">
                            <TextBlock Style="{StaticResource BaselineToastText}"
                                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[NeedSelect]}"/>
                        </Border>
                    </Popup>
            </StackPanel>

            <!-- Generator + Row height (kept on main toolbar, now next to entry action icons) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,0" IsEnabled="{Binding IsUnlocked}">
                    <Button Click="OpenGenerator_Click"
                            Style="{StaticResource BaselineToolbarTextButton}"
                            Margin="0,0,12,0">
                        <Button.Content>
                            <MultiBinding Converter="{StaticResource WidthToTextConverter}" ConverterParameter="750">
                                <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="ActualWidth"/>
                                <Binding Source="{x:Static local:Loc.Instance}" Path="[OpenGenerator]"/>
                                <Binding Source="{x:Static local:Loc.Instance}" Path="[OpenGeneratorShort]"/>
                            </MultiBinding>
                        </Button.Content>
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0"
                                   Text="{Binding Source={x:Static local:Loc.Instance}, Path=[RowHeight]}"/>
                        <Slider x:Name="RowHeightSlider" Width="110" Minimum="18" Maximum="34" Value="22"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                Focusable="False" IsTabStop="False"
                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock VerticalAlignment="Center" MinWidth="28"
                                   Text="{Binding ElementName=RowHeightSlider, Path=Value, StringFormat={}{0:0}}"/>
                    </StackPanel>
            </StackPanel>
        </Grid>
        </Border>

        <!-- Bottom status bar (minimal) -->
        <Border DockPanel.Dock="Bottom"
                Margin="14,8,0,0"
                Background="{DynamicResource Brush.SurfaceSubtleBackground}"
                BorderBrush="{DynamicResource Brush.BorderStrong}"
                BorderThickness="1"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <TextBlock FontSize="11"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Padding="8,6,8,6">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}: {1} | {2}: {3} | {4}: {5}">
                        <Binding Source="{x:Static local:Loc.Instance}" Path="ContextLabel"/>
                        <Binding Path="ActiveContextTitle"/>
                        <Binding Source="{x:Static local:Loc.Instance}" Path="EntriesCountLabel"/>
                        <Binding Path="DisplayedEntriesCount"/>
                        <Binding Source="{x:Static local:Loc.Instance}" Path="SelectedCountLabel"/>
                        <Binding Path="SelectedEntriesCount"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>
        <!-- Main area: folders (left) + grid (right) -->
