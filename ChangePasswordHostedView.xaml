<UserControl x:Class="PassNotes.ChangePasswordHostedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PassNotes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[OldPassword]}"/>
            <PasswordBox x:Name="OldPwd"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[NewPassword]}"/>
            <PasswordBox x:Name="NewPwd1"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Text="{Binding Source={x:Static local:Loc.Instance}, Path=[ConfirmPassword]}"/>
            <PasswordBox x:Name="NewPwd2"
                         Grid.Column="1"
                         Margin="8,0,0,0"
                         ContextMenu="{StaticResource BaselineTextCommandsContextMenu}"/>
        </Grid>

        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="8"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>

