<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Baseline.Neutral.Brushes.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!--
    Midnight Slate: graphite-slate dark theme built on the shared Brush.* runtime contract.
    The accent stays muted sage and is used only for focus, selection and primary actions.
  -->

  <!-- Surface roles -->
  <SolidColorBrush x:Key="Brush.AppBackground" Color="#16181C"/>
  <SolidColorBrush x:Key="Brush.WindowBackground" Color="#1A1E23"/>
  <SolidColorBrush x:Key="Brush.ControlBackground" Color="#20262D"/>
  <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="#20262D"/>
  <SolidColorBrush x:Key="Brush.SurfaceAltBackground" Color="#272F37"/>
  <SolidColorBrush x:Key="Brush.SurfaceSubtleBackground" Color="#1E2329"/>
  <SolidColorBrush x:Key="Brush.DialogWindowBackground" Color="#191C20"/>
  <SolidColorBrush x:Key="Brush.DialogSurfaceBackground" Color="#232A31"/>
  <SolidColorBrush x:Key="Brush.DialogSurfaceBorder" Color="#4A5661"/>
  <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#CC16181C"/>
  <SolidColorBrush x:Key="Brush.ScrollBarTrackBackground" Color="#2C343C"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumb" Color="#434E58"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumbHover" Color="#56626D"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumbPressed" Color="#66737C"/>
  <SolidColorBrush x:Key="Brush.SliderTrackBackground" Color="#35404A"/>
  <SolidColorBrush x:Key="Brush.SliderTrackFill" Color="#66745F"/>
  <SolidColorBrush x:Key="Brush.SliderThumb" Color="#BBC3CA"/>
  <SolidColorBrush x:Key="Brush.SliderThumbBorder" Color="#3B4650"/>
  <SolidColorBrush x:Key="Brush.SliderThumbHoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.SliderThumbPressedBorder" Color="#55636E"/>
  <SolidColorBrush x:Key="Brush.ToastBackground" Color="#2A3138"/>
  <SolidColorBrush x:Key="Brush.ToastBorder" Color="#3A444D"/>
  <SolidColorBrush x:Key="Brush.ToastForeground" Color="#E7ECEF"/>

  <!-- Text and icon roles -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#E7ECEF"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#B8C0C7"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#8E98A1"/>
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#69737C"/>
  <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#F8FAF8"/>
  <SolidColorBrush x:Key="Brush.Caret" Color="#E7ECEF"/>
  <SolidColorBrush x:Key="Brush.TitleBarText" Color="#E7ECEF"/>
  <SolidColorBrush x:Key="Brush.Icon" Color="#A5AFB7"/>
  <SolidColorBrush x:Key="Brush.IconMuted" Color="#88929B"/>

  <!-- Structural borders and separators -->
  <SolidColorBrush x:Key="Brush.Border" Color="#3B4650"/>
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#4A5661"/>
  <SolidColorBrush x:Key="Brush.TitleBarBackground" Color="#1A1E23"/>
  <SolidColorBrush x:Key="Brush.TitleBarBorder" Color="#4A5661"/>
  <SolidColorBrush x:Key="Brush.GridLine" Color="#37424B"/>
  <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#1E242A"/>
  <SolidColorBrush x:Key="Brush.Divider" Color="#35404A"/>
  <SolidColorBrush x:Key="Brush.Separator" Color="#35404A"/>

  <!-- Accent, focus and shared state family -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#91A27A"/>
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#6E7D5B"/>
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#2D352C"/>
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#293139"/>
  <SolidColorBrush x:Key="Brush.ControlPressed" Color="#2E363E"/>
  <SolidColorBrush x:Key="Brush.ControlFocus" Color="#394740"/>
  <SolidColorBrush x:Key="Brush.HoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.PressedBorder" Color="#55636E"/>
  <SolidColorBrush x:Key="Brush.FocusBorder" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.HoverBackground" Color="#293139"/>
  <SolidColorBrush x:Key="Brush.PressedBackground" Color="#2E363E"/>
  <SolidColorBrush x:Key="Brush.ButtonFocusBorder" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.ButtonDefaultBorder" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.ButtonDefaultBackground" Color="#2D352C"/>
  <SolidColorBrush x:Key="Brush.DialogButtonBackground" Color="#1D2328"/>
  <SolidColorBrush x:Key="Brush.DialogButtonBorder" Color="#434E58"/>
  <SolidColorBrush x:Key="Brush.DialogButtonHoverBackground" Color="#293139"/>
  <SolidColorBrush x:Key="Brush.DialogButtonHoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.DialogButtonPressedBackground" Color="#2E363E"/>
  <SolidColorBrush x:Key="Brush.DialogButtonPressedBorder" Color="#55636E"/>
  <SolidColorBrush x:Key="Brush.DialogButtonDefaultBackground" Color="#2D352C"/>
  <SolidColorBrush x:Key="Brush.DialogButtonDefaultBorder" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.DialogButtonFocusBorder" Color="#7F8F6A"/>
  <SolidColorBrush x:Key="Brush.InputBackgroundDisabled" Color="#1C2025"/>
  <SolidColorBrush x:Key="Brush.ToggleCheckedBackground" Color="#2F382F"/>
  <SolidColorBrush x:Key="Brush.ToggleCheckedBorder" Color="#7F8F6A"/>

  <!-- Selection and list/tree/grid states -->
  <SolidColorBrush x:Key="Brush.SelectionActive" Color="#313A32"/>
  <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#2B322E"/>
  <SolidColorBrush x:Key="Brush.TreeListItemHoverBackground" Color="#283039"/>
  <SolidColorBrush x:Key="Brush.TreeListItemHoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.TreeListSelectionBackground" Color="#313A32"/>
  <SolidColorBrush x:Key="Brush.TreeListSelectionBorder" Color="#66745F"/>
  <SolidColorBrush x:Key="Brush.TreeListInactiveSelectionBackground" Color="#2B322E"/>
  <SolidColorBrush x:Key="Brush.TreeListInactiveSelectionBorder" Color="#505C56"/>
  <SolidColorBrush x:Key="Brush.GridRowHoverBackground" Color="#283039"/>
  <SolidColorBrush x:Key="Brush.GridRowSelectionBackground" Color="#313A32"/>
  <SolidColorBrush x:Key="Brush.GridRowInactiveSelectionBackground" Color="#2B322E"/>
  <SolidColorBrush x:Key="Brush.PopupItemHoverBackground" Color="#283039"/>
  <SolidColorBrush x:Key="Brush.PopupItemHoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.PopupItemCurrentBackground" Color="#313A32"/>
  <SolidColorBrush x:Key="Brush.PopupItemCurrentBorder" Color="#66745F"/>
  <SolidColorBrush x:Key="Brush.PopupItemPressedBackground" Color="#2D353D"/>
  <SolidColorBrush x:Key="Brush.PopupItemPressedBorder" Color="#55636E"/>
  <SolidColorBrush x:Key="Brush.ListItemHoverBackground" Color="#283039" Opacity="0.88"/>
  <SolidColorBrush x:Key="Brush.ListItemHoverBorder" Color="#495661"/>
  <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#313A32"/>
  <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#66745F"/>
  <SolidColorBrush x:Key="Brush.InactiveSelectionBackground" Color="#2B322E"/>
  <SolidColorBrush x:Key="Brush.InactiveSelectionBorder" Color="#505C56"/>
  <SolidColorBrush x:Key="Brush.DropTargetBackground" Color="#314036" Opacity="0.72"/>
  <SolidColorBrush x:Key="Brush.DropTargetBorder" Color="#74846A" Opacity="0.90"/>
  <SolidColorBrush x:Key="Brush.ActiveContextMarker" Color="#91A27A"/>
  <SolidColorBrush x:Key="Brush.TreeItemBackground" Color="Transparent"/>
  <SolidColorBrush x:Key="Brush.TreeItemBorder" Color="Transparent"/>

  <!-- Semantic roles -->
  <SolidColorBrush x:Key="Brush.Success" Color="#7FA46B"/>
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#223126"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="#C59A5A"/>
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#332A1E"/>
  <SolidColorBrush x:Key="Brush.Error" Color="#C46F6A"/>
  <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#372221"/>
  <SolidColorBrush x:Key="Brush.Info" Color="#7D96A8"/>
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="#222D35"/>

  <!-- Disabled family -->
  <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#1C2025"/>
  <SolidColorBrush x:Key="Brush.DisabledBorder" Color="#2C333A"/>
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#636C74"/>

  <!-- Baseline tab family -->
  <SolidColorBrush x:Key="Brush.TabBackground" Color="#1E242A"/>
  <SolidColorBrush x:Key="Brush.TabHoverBackground" Color="#283039"/>
  <SolidColorBrush x:Key="Brush.TabSelectedBackground" Color="#232A31"/>
  <SolidColorBrush x:Key="Brush.TabSelectedBorder" Color="#4A5661"/>
</ResourceDictionary>
