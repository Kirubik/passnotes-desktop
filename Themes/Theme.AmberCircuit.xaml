<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Baseline.Neutral.Brushes.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!--
    Amber Circuit: dark cinematic runtime theme inspired by amber/cyan sci-fi UI language.
    The first pass stays inside the shared Brush.* contract and avoids heavy visual effects.
  -->

  <!-- Surface roles -->
  <SolidColorBrush x:Key="Brush.AppBackground" Color="#090B0E"/>
  <SolidColorBrush x:Key="Brush.WindowBackground" Color="#0E1216"/>
  <SolidColorBrush x:Key="Brush.ControlBackground" Color="#141A1F"/>
  <SolidColorBrush x:Key="Brush.SurfaceBackground" Color="#151B21"/>
  <SolidColorBrush x:Key="Brush.SurfaceAltBackground" Color="#1B2329"/>
  <SolidColorBrush x:Key="Brush.SurfaceSubtleBackground" Color="#12181D"/>
  <SolidColorBrush x:Key="Brush.DialogWindowBackground" Color="#0F1418"/>
  <SolidColorBrush x:Key="Brush.DialogSurfaceBackground" Color="#182028"/>
  <SolidColorBrush x:Key="Brush.DialogSurfaceBorder" Color="#845F34"/>
  <SolidColorBrush x:Key="Brush.OverlayBackground" Color="#D9090B0E"/>
  <SolidColorBrush x:Key="Brush.ScrollBarTrackBackground" Color="#171D22"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumb" Color="#8E6733"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumbHover" Color="#C98A37"/>
  <SolidColorBrush x:Key="Brush.ScrollBarThumbPressed" Color="#E49A3A"/>
  <SolidColorBrush x:Key="Brush.SliderTrackBackground" Color="#3C2C1D"/>
  <SolidColorBrush x:Key="Brush.SliderTrackFill" Color="#C78234"/>
  <LinearGradientBrush x:Key="Brush.SliderThumb" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#5B4023" Offset="0"/>
    <GradientStop Color="#6C4A26" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.SliderThumbBorder" Color="#75552F"/>
  <SolidColorBrush x:Key="Brush.SliderThumbHoverBorder" Color="#89653A"/>
  <SolidColorBrush x:Key="Brush.SliderThumbPressedBorder" Color="#9B7240"/>
  <SolidColorBrush x:Key="Brush.ToastBackground" Color="#141B21"/>
  <SolidColorBrush x:Key="Brush.ToastBorder" Color="#986B35"/>
  <SolidColorBrush x:Key="Brush.ToastForeground" Color="#F0D7AE"/>

  <!-- Text and icon roles -->
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#ECD3A6"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CDB38B"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#8D8A82"/>
  <SolidColorBrush x:Key="Brush.TextDisabled" Color="#62666A"/>
  <SolidColorBrush x:Key="Brush.TextOnAccent" Color="#FFF6E8"/>
  <SolidColorBrush x:Key="Brush.Caret" Color="#F2BC6A"/>
  <SolidColorBrush x:Key="Brush.TitleBarText" Color="#EAC995"/>
  <SolidColorBrush x:Key="Brush.Icon" Color="#D0AE7A"/>
  <SolidColorBrush x:Key="Brush.IconMuted" Color="#807B73"/>

  <!-- Structural borders and separators -->
  <SolidColorBrush x:Key="Brush.Border" Color="#6A5437"/>
  <SolidColorBrush x:Key="Brush.BorderStrong" Color="#A87539"/>
  <SolidColorBrush x:Key="Brush.TitleBarBackground" Color="#0D1014"/>
  <SolidColorBrush x:Key="Brush.TitleBarBorder" Color="#8E6733"/>
  <SolidColorBrush x:Key="Brush.GridLine" Color="#5A4A3A"/>
  <LinearGradientBrush x:Key="Brush.GridHeaderBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#25180F" Offset="0"/>
    <GradientStop Color="#3C230F" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.Divider" Color="#855F31"/>
  <SolidColorBrush x:Key="Brush.Separator" Color="#855F31"/>

  <!-- Accent, focus and shared state family -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFB958"/>
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#D98B24"/>
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="#392715"/>
  <SolidColorBrush x:Key="Brush.ControlHover" Color="#1B2D34"/>
  <SolidColorBrush x:Key="Brush.ControlPressed" Color="#21363E"/>
  <SolidColorBrush x:Key="Brush.ControlFocus" Color="#233940"/>
  <SolidColorBrush x:Key="Brush.HoverBorder" Color="#536E75"/>
  <SolidColorBrush x:Key="Brush.PressedBorder" Color="#66777E"/>
  <SolidColorBrush x:Key="Brush.FocusBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.HoverBackground" Color="#1B2D34"/>
  <SolidColorBrush x:Key="Brush.PressedBackground" Color="#21363E"/>
  <SolidColorBrush x:Key="Brush.ButtonFocusBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.ButtonDefaultBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.ButtonDefaultBackground" Color="#392715"/>
  <SolidColorBrush x:Key="Brush.DialogButtonBackground" Color="#151C22"/>
  <SolidColorBrush x:Key="Brush.DialogButtonBorder" Color="#845F34"/>
  <SolidColorBrush x:Key="Brush.DialogButtonHoverBackground" Color="#1B2D34"/>
  <SolidColorBrush x:Key="Brush.DialogButtonHoverBorder" Color="#536E75"/>
  <SolidColorBrush x:Key="Brush.DialogButtonPressedBackground" Color="#21363E"/>
  <SolidColorBrush x:Key="Brush.DialogButtonPressedBorder" Color="#66777E"/>
  <SolidColorBrush x:Key="Brush.DialogButtonDefaultBackground" Color="#2E2014"/>
  <SolidColorBrush x:Key="Brush.DialogButtonDefaultBorder" Color="#C78234"/>
  <SolidColorBrush x:Key="Brush.DialogButtonFocusBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.InputBackgroundDisabled" Color="#101419"/>
  <SolidColorBrush x:Key="Brush.ToggleCheckedBackground" Color="#392715"/>
  <SolidColorBrush x:Key="Brush.ToggleCheckedBorder" Color="#F0A33A"/>

  <!-- Selection and list/tree/grid states -->
  <SolidColorBrush x:Key="Brush.SelectionActive" Color="#312317"/>
  <SolidColorBrush x:Key="Brush.SelectionInactive" Color="#241D17"/>
  <SolidColorBrush x:Key="Brush.TreeListItemHoverBackground" Color="#1E343A"/>
  <SolidColorBrush x:Key="Brush.TreeListItemHoverBorder" Color="#6C878E"/>
  <SolidColorBrush x:Key="Brush.TreeListSelectionBackground" Color="#392617"/>
  <SolidColorBrush x:Key="Brush.TreeListSelectionBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.TreeListInactiveSelectionBackground" Color="#241D17"/>
  <SolidColorBrush x:Key="Brush.TreeListInactiveSelectionBorder" Color="#7A5A32"/>
  <SolidColorBrush x:Key="Brush.GridRowHoverBackground" Color="#20363C"/>
  <SolidColorBrush x:Key="Brush.GridRowSelectionBackground" Color="#392617"/>
  <SolidColorBrush x:Key="Brush.GridRowInactiveSelectionBackground" Color="#241D17"/>
  <SolidColorBrush x:Key="Brush.PopupItemHoverBackground" Color="#213A41"/>
  <SolidColorBrush x:Key="Brush.PopupItemHoverBorder" Color="#48636A"/>
  <SolidColorBrush x:Key="Brush.PopupItemCurrentBackground" Color="#392617"/>
  <SolidColorBrush x:Key="Brush.PopupItemCurrentBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.PopupItemPressedBackground" Color="#2A3035"/>
  <SolidColorBrush x:Key="Brush.PopupItemPressedBorder" Color="#86643A"/>
  <SolidColorBrush x:Key="Brush.ListItemHoverBackground" Color="#1B2D34" Opacity="0.88"/>
  <SolidColorBrush x:Key="Brush.ListItemHoverBorder" Color="#48636A"/>
  <SolidColorBrush x:Key="Brush.SelectionBackground" Color="#392617"/>
  <SolidColorBrush x:Key="Brush.SelectionBorder" Color="#F0A33A"/>
  <SolidColorBrush x:Key="Brush.InactiveSelectionBackground" Color="#241D17"/>
  <SolidColorBrush x:Key="Brush.InactiveSelectionBorder" Color="#7A5A32"/>
  <SolidColorBrush x:Key="Brush.DropTargetBackground" Color="#4F3514" Opacity="0.72"/>
  <SolidColorBrush x:Key="Brush.DropTargetBorder" Color="#FFBA56" Opacity="0.90"/>
  <SolidColorBrush x:Key="Brush.ActiveContextMarker" Color="#FFB84D"/>
  <SolidColorBrush x:Key="Brush.TreeItemBackground" Color="Transparent"/>
  <SolidColorBrush x:Key="Brush.TreeItemBorder" Color="Transparent"/>

  <!-- Semantic roles -->
  <SolidColorBrush x:Key="Brush.Success" Color="#8FA869"/>
  <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#223025"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="#D19A4B"/>
  <SolidColorBrush x:Key="Brush.WarningSoft" Color="#372817"/>
  <SolidColorBrush x:Key="Brush.Error" Color="#C76F57"/>
  <SolidColorBrush x:Key="Brush.ErrorSoft" Color="#351E1A"/>
  <SolidColorBrush x:Key="Brush.Info" Color="#5BA1AA"/>
  <SolidColorBrush x:Key="Brush.InfoSoft" Color="#1B2D34"/>

  <!-- Disabled family -->
  <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#101419"/>
  <SolidColorBrush x:Key="Brush.DisabledBorder" Color="#262B31"/>
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#62666A"/>

  <!-- Baseline tab family -->
  <SolidColorBrush x:Key="Brush.TabBackground" Color="#171C20"/>
  <SolidColorBrush x:Key="Brush.TabHoverBackground" Color="#1B2D34"/>
  <LinearGradientBrush x:Key="Brush.TabSelectedBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2B190D" Offset="0"/>
    <GradientStop Color="#46250F" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="Brush.TabSelectedBorder" Color="#C78234"/>
</ResourceDictionary>
