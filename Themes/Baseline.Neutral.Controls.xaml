<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:beh="clr-namespace:PassNotes.Behaviors"
                    xmlns:local="clr-namespace:PassNotes">
  <local:IconDataResourceResolverConverter x:Key="IconDataResourceResolverConverter"/>

  <!-- Shared button primitives. They are opt-in for now; window-level reset blocks decide where to apply them. -->
  <Style x:Key="BaselineButtonMetrics" TargetType="{x:Type ButtonBase}">
    <Setter Property="MinHeight" Value="{StaticResource Metric.ButtonMinHeight}"/>
    <Setter Property="Padding" Value="{StaticResource Thickness.ButtonPadding}"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="BaselineButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineButtonMetrics}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerRadius.Surface}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PressedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PressedBorder}"/>
      </Trigger>
      <Trigger Property="IsDefaulted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ButtonDefaultBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonDefaultBorder}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsDefaulted" Value="True"/>
          <Condition Property="IsMouseOver" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonDefaultBorder}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsDefaulted" Value="True"/>
          <Condition Property="IsPressed" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.PressedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonDefaultBorder}"/>
      </MultiTrigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonFocusBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.DisabledBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DisabledBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BaselineToggleButton" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource BaselineButtonMetrics}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerRadius.Surface}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.HoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.HoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.PressedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PressedBorder}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ButtonFocusBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.ToggleCheckedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToggleCheckedBorder}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsChecked" Value="True"/>
          <Condition Property="IsMouseOver" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.ToggleCheckedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ToggleCheckedBorder}"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.DisabledBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DisabledBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="DialogButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineButtonMetrics}">
    <Setter Property="MinWidth" Value="{StaticResource Metric.DialogButtonMinWidth}"/>
  </Style>

  <Style x:Key="BaselineDialogButton" TargetType="{x:Type Button}" BasedOn="{StaticResource BaselineButtonMetrics}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
    <Setter Property="MinWidth" Value="{StaticResource Metric.DialogButtonMinWidth}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerRadius.Surface}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonHoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonHoverBorder}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonPressedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonPressedBorder}"/>
      </Trigger>
      <Trigger Property="IsDefaulted" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonDefaultBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonDefaultBorder}"/>
      </Trigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsDefaulted" Value="True"/>
          <Condition Property="IsMouseOver" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonHoverBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonDefaultBorder}"/>
      </MultiTrigger>
      <MultiTrigger>
        <MultiTrigger.Conditions>
          <Condition Property="IsDefaulted" Value="True"/>
          <Condition Property="IsPressed" Value="True"/>
        </MultiTrigger.Conditions>
        <Setter Property="Background" Value="{DynamicResource Brush.DialogButtonPressedBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonDefaultBorder}"/>
      </MultiTrigger>
      <Trigger Property="IsKeyboardFocused" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DialogButtonFocusBorder}"/>
        <Setter Property="BorderThickness" Value="2"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="{DynamicResource Brush.DisabledBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.DisabledText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DisabledBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BaselineDialogWindow" TargetType="{x:Type Window}">
    <Setter Property="Background" Value="{DynamicResource Brush.DialogWindowBackground}"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="BaselineDialogSurfaceBorder" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Brush.DialogWindowBackground}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="12"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="BaselineDialogActionsPanel" TargetType="{x:Type StackPanel}">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,14,0,0"/>
  </Style>

  <Style x:Key="BaselineDialogBodyScrollViewer" TargetType="{x:Type ScrollViewer}">
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="CanContentScroll" Value="False"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="PanningMode" Value="VerticalFirst"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <Style x:Key="BaselineScrollBarPageButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BaselineSliderRepeatButtonBase" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource CornerRadius.Small}"
                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BaselineSliderDecreaseRepeatButton" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource BaselineSliderRepeatButtonBase}">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style x:Key="BaselineSliderIncreaseRepeatButton" TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource BaselineSliderRepeatButtonBase}">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style x:Key="BaselineSliderThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{DynamicResource Brush.SliderThumb}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.SliderThumbBorder}"/>
    <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
    <Setter Property="Width" Value="{StaticResource Metric.SliderThumbWidth}"/>
    <Setter Property="Height" Value="{StaticResource Metric.SliderThumbHeight}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="Transparent"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
            <Border x:Name="ThumbVisual"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource CornerRadius.Surface}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    UseLayoutRounding="{TemplateBinding UseLayoutRounding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.SliderThumb}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.SliderThumbHoverBorder}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.SliderThumb}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.SliderThumbPressedBorder}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="BaselineHorizontalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid Background="Transparent"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
      <Border Height="{StaticResource Metric.SliderTrackThickness}"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.SliderTrackBackground}"
              CornerRadius="{StaticResource CornerRadius.Small}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      <Track x:Name="PART_Track"
             VerticalAlignment="Center"
             Focusable="False"
             Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
             IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineSliderDecreaseRepeatButton}"
                        Command="{x:Static Slider.DecreaseLarge}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource BaselineSliderThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineSliderIncreaseRepeatButton}"
                        Command="{x:Static Slider.IncreaseLarge}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="BaselineVerticalSliderTemplate" TargetType="{x:Type Slider}">
    <Grid Background="Transparent"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
      <Border Width="{StaticResource Metric.SliderTrackThickness}"
              HorizontalAlignment="Center"
              Background="{DynamicResource Brush.SliderTrackBackground}"
              CornerRadius="{StaticResource CornerRadius.Small}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      <Track x:Name="PART_Track"
             HorizontalAlignment="Center"
             Focusable="False"
             Minimum="{TemplateBinding Minimum}"
             Maximum="{TemplateBinding Maximum}"
             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
             Orientation="Vertical"
             IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineSliderDecreaseRepeatButton}"
                        Command="{x:Static Slider.DecreaseLarge}"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource BaselineSliderThumb}"
                 Width="{StaticResource Metric.SliderThumbHeight}"
                 Height="{StaticResource Metric.SliderThumbWidth}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineSliderIncreaseRepeatButton}"
                        Command="{x:Static Slider.IncreaseLarge}"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type Slider}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="MinHeight" Value="{StaticResource Metric.SliderThumbHeight}"/>
        <Setter Property="Template" Value="{StaticResource BaselineHorizontalSliderTemplate}"/>
      </Trigger>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="MinWidth" Value="{StaticResource Metric.SliderThumbHeight}"/>
        <Setter Property="Template" Value="{StaticResource BaselineVerticalSliderTemplate}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="BaselineVerticalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumb}"/>
    <Setter Property="MinHeight" Value="{StaticResource Metric.ScrollBarThumbMinLength}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="beh:ScrollBarThumbBehavior.Enable" Value="True"/>
    <Setter Property="beh:ScrollBarThumbBehavior.Axis" Value="{x:Static beh:ScrollBarThumbAxis.Vertical}"/>
    <Setter Property="beh:ScrollBarThumbBehavior.CompactThreshold" Value="{StaticResource Metric.ScrollBarThumbCompactThreshold}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="Transparent"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
            <Border x:Name="ThumbVisual"
                    Margin="{StaticResource Thickness.ScrollBarVerticalThumbMargin}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource CornerRadius.ScrollBarThumb}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    UseLayoutRounding="{TemplateBinding UseLayoutRounding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="beh:ScrollBarThumbBehavior.IsCompact" Value="True">
              <Setter TargetName="ThumbVisual" Property="Margin" Value="{StaticResource Thickness.ScrollBarVerticalThumbCompactMargin}"/>
              <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="{StaticResource CornerRadius.ScrollBarThumbCompact}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumbPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="BaselineHorizontalScrollBarThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumb}"/>
    <Setter Property="MinWidth" Value="{StaticResource Metric.ScrollBarThumbMinLength}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="beh:ScrollBarThumbBehavior.Enable" Value="True"/>
    <Setter Property="beh:ScrollBarThumbBehavior.Axis" Value="{x:Static beh:ScrollBarThumbAxis.Horizontal}"/>
    <Setter Property="beh:ScrollBarThumbBehavior.CompactThreshold" Value="{StaticResource Metric.ScrollBarThumbCompactThreshold}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Grid Background="Transparent"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                UseLayoutRounding="{TemplateBinding UseLayoutRounding}">
            <Border x:Name="ThumbVisual"
                    Margin="{StaticResource Thickness.ScrollBarHorizontalThumbMargin}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource CornerRadius.ScrollBarThumb}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    UseLayoutRounding="{TemplateBinding UseLayoutRounding}"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="beh:ScrollBarThumbBehavior.IsCompact" Value="True">
              <Setter TargetName="ThumbVisual" Property="Margin" Value="{StaticResource Thickness.ScrollBarHorizontalThumbCompactMargin}"/>
              <Setter TargetName="ThumbVisual" Property="CornerRadius" Value="{StaticResource CornerRadius.ScrollBarThumbCompact}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumbHover}"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter Property="Background" Value="{DynamicResource Brush.ScrollBarThumbPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ThumbVisual" Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="BaselineVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid Background="Transparent"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
      <Border Margin="{StaticResource Thickness.ScrollBarVerticalRailMargin}"
              Background="{DynamicResource Brush.ScrollBarTrackBackground}"
              CornerRadius="{StaticResource CornerRadius.ScrollBarTrack}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      <Track x:Name="PART_Track"
             Margin="{StaticResource Thickness.ScrollBarVerticalRailMargin}"
             IsDirectionReversed="True"
             Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource BaselineVerticalScrollBarThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <ControlTemplate x:Key="BaselineHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
    <Grid Background="Transparent"
          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
      <Border Margin="{StaticResource Thickness.ScrollBarHorizontalRailMargin}"
              Background="{DynamicResource Brush.ScrollBarTrackBackground}"
              CornerRadius="{StaticResource CornerRadius.ScrollBarTrack}"
              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
      <Track x:Name="PART_Track"
             Margin="{StaticResource Thickness.ScrollBarHorizontalRailMargin}"
             Focusable="False">
        <Track.DecreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
          <Thumb Style="{StaticResource BaselineHorizontalScrollBarThumb}"/>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
          <RepeatButton Style="{StaticResource BaselineScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
        </Track.IncreaseRepeatButton>
      </Track>
    </Grid>
  </ControlTemplate>

  <Style TargetType="{x:Type ScrollBar}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Vertical">
        <Setter Property="Width" Value="{StaticResource Metric.ScrollBarThickness}"/>
        <Setter Property="MinWidth" Value="{StaticResource Metric.ScrollBarThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Template" Value="{StaticResource BaselineVerticalScrollBarTemplate}"/>
      </Trigger>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Height" Value="{StaticResource Metric.ScrollBarThickness}"/>
        <Setter Property="MinHeight" Value="{StaticResource Metric.ScrollBarThickness}"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Template" Value="{StaticResource BaselineHorizontalScrollBarTemplate}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.55"/>
      </Trigger>
    </Style.Triggers>
