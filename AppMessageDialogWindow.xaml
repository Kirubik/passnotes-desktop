<Window x:Class="PassNotes.AppMessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220"
        Width="460"
        MinWidth="420"
        MinHeight="220"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource BaselineDialogWindow}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource BaselineDialogSurfaceBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="TitleTextBlock"
                           Grid.Row="0"
                           Style="{StaticResource BaselineDialogTitleText}"/>

                <ScrollViewer Grid.Row="2"
                              Style="{StaticResource BaselineDialogBodyScrollViewer}">
                    <TextBlock x:Name="MessageTextBlock"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Style="{StaticResource BaselineDialogActionsPanel}">
            <Button x:Name="YesButton"
                    Style="{StaticResource BaselineDialogButton}"
                    Margin="0,0,8,0"
                    Click="YesButton_Click"/>
            <Button x:Name="NoButton"
                    Style="{StaticResource BaselineDialogButton}"
                    Margin="0,0,8,0"
                    Click="NoButton_Click"/>
            <Button x:Name="CancelButton"
                    Style="{StaticResource BaselineDialogButton}"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton"
                    Style="{StaticResource BaselineDialogButton}"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
