<UserControl x:Class="PassNotes.HelpHostedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PassNotes"
             MinWidth="0"
             MinHeight="0">

    <Grid Margin="0"
          MinWidth="0"
          MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource BaselinePassiveInsetStripBorder}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal">
                    <Button x:Name="BackBtn"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Click="Back_Click"
                            Style="{StaticResource BaselineButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[HelpBack]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}"
                                        Width="14"
                                        Height="14"
                                        Content="{StaticResource IconData.Navigate.Back}"/>
                    </Button>
                    <Button x:Name="ForwardBtn"
                            Width="34"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            Click="Forward_Click"
                            Style="{StaticResource BaselineButton}"
                            ToolTip="{Binding Source={x:Static local:Loc.Instance}, Path=[HelpForward]}">
                        <ContentControl Style="{StaticResource BaselineVectorIconPresenter}"
                                        Width="14"
                                        Height="14"
                                        Content="{StaticResource IconData.Navigate.Forward}"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2"
              MinWidth="0"
              MinHeight="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource BaselinePassiveInsetStripBorder}">
                <ListBox x:Name="TocList"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource BaselineListBoxItem}"
                         SelectionChanged="TocList_SelectionChanged"
                         Style="{StaticResource BaselineListBox}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Column="2"
                  MinWidth="0"
                  MinHeight="0">
                <Border Padding="0"
                        MinHeight="0"
                        Style="{StaticResource BaselinePassiveInsetStripBorder}">
                    <WebBrowser x:Name="Browser"
                                LoadCompleted="Browser_LoadCompleted"
                                Navigating="Browser_Navigating"/>
                </Border>

                <Border x:Name="ErrorOverlay"
                        Visibility="Collapsed"
                        Margin="18"
                        Background="{DynamicResource Brush.OverlayBackground}"
                        Style="{StaticResource BaselineInsetStripBorder}">
                    <StackPanel Margin="8">
                        <TextBlock FontSize="14"
                                   Style="{StaticResource BaselineDialogTitleText}"
                                   Text="{Binding Source={x:Static local:Loc.Instance}, Path=[HelpErrorTitle]}"/>
                        <TextBlock x:Name="ErrorText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
