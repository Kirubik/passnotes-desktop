<UserControl x:Class="PassNotes.SupportAuthorHostedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="SupportAuthorServiceCardBorder"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource BaselinePassiveInsetStripBorder}">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SupportAuthorLogoPlateBorder" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="148"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Background" Value="#F8F9FB"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="{StaticResource Thickness.ControlBorder}"/>
            <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Surface}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SupportAuthorSectionHeaderText" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,14,0,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SupportAuthorValueText" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SupportAuthorInlineIconButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaselineToolbarIconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="8,4,0,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="SupportAuthorCardTemplate">
            <Border Style="{StaticResource SupportAuthorServiceCardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Width="148"
                                VerticalAlignment="Top">
                        <Border Style="{StaticResource SupportAuthorLogoPlateBorder}">
                            <Grid>
                                <Image Source="{Binding LogoUri}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       SnapsToDevicePixels="True"
                                       Visibility="{Binding HasLogoUri, Converter={StaticResource BoolToVis}}"/>

                                <ContentControl Style="{StaticResource BaselineVectorIconPresenter}"
                                                Width="24"
                                                Height="24"
                                                Foreground="{DynamicResource Brush.TextSecondary}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Content="{Binding VectorIconKey}"
                                                Visibility="{Binding HasVectorIconKey, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding ValueItems}"
                                      Visibility="{Binding HasValueItems, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource SupportAuthorValueText}"
                                                   Text="{Binding Text}"
                                                   ToolTip="{Binding ValueUrl}"
                                                   Tag="{Binding ValueUrl}"
                                                   IsHitTestVisible="{Binding CanOpenValueText}"
                                                   MouseLeftButtonUp="SupportValueText_MouseLeftButtonUp"/>

                                        <Button Grid.Column="1"
                                                Style="{StaticResource SupportAuthorInlineIconButton}"
                                                Click="SupportCopyValueButton_Click"
                                                Tag="{Binding CopyText}"
                                                ToolTip="{Binding CopyValueToolTip}"
                                                Visibility="{Binding CanCopyValue, Converter={StaticResource BoolToVis}}">
                                            <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                            Content="IconData.Copy"/>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Style="{StaticResource SupportAuthorInlineIconButton}"
                                                Click="SupportOpenValueButton_Click"
                                                Tag="{Binding ValueUrl}"
                                                ToolTip="{Binding OpenValueToolTip}"
                                                Visibility="{Binding CanOpenValueInBrowser, Converter={StaticResource BoolToVis}}">
                                            <ContentControl Style="{StaticResource BaselineVectorSmallIconPresenter}"
                                                            Content="IconData.Open"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource BaselineDialogBodyScrollViewer}">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="{Binding Description}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>

            <TextBlock Style="{StaticResource SupportAuthorSectionHeaderText}"
                       Text="{Binding LinksHeader}"/>

            <ItemsControl ItemsSource="{Binding Services}"
                          ItemTemplate="{StaticResource SupportAuthorCardTemplate}"/>

            <TextBlock Style="{StaticResource SupportAuthorSectionHeaderText}"
                       Text="{Binding ContactsHeader}"/>

            <ItemsControl ItemsSource="{Binding Contacts}"
                          ItemTemplate="{StaticResource SupportAuthorCardTemplate}"/>

            <TextBlock Text="{Binding BrowserHint}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
